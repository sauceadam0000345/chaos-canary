# Copy this file to .env and fill in your real values.
# .env is git-ignored so your credentials never leave your machine.

# Your Sauce Labs credentials (found in the Sauce Labs dashboard
# under Account > User Settings).
SAUCE_USERNAME=your-sauce-username
SAUCE_ACCESS_KEY=your-sauce-access-key

# Sauce Labs data center region, e.g. us-west-1, eu-central-1
SAUCE_REGION=us-west-1
